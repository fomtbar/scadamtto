# ==============================================================
#  scadaMtto web - configuracion
#
#  Copiar a .env (o dejar que lo genere ./deploy.sh --setup).
#  Escribir SIEMPRE con LF y sin BOM: un BOM hace que docker compose
#  lea mal la primera clave y la variable no exista.
# ==============================================================

DEPLOY_BRANCH=main

# ---- Base de datos -------------------------------------------
# SQL Server de la compania. Esta app SOLO LEE la tabla del adquisidor.
# Conviene un usuario con permiso de SELECT y nada mas.
#
# OJO: 'localhost' NO sirve (desde el contenedor apunta al contenedor).
DB_HOST=172.17.132.153
DB_PUERTO=1433
DB_NOMBRE=Mantenimiento
DB_USUARIO=

# NO usar  ;  {  }  $  "  '  #   en la contrasena ('$' lo interpola
# compose y '#' trunca el valor). Seguros:  _  -  !  %  ^  &  *  +  =
DB_PASSWORD=

DB_TRUST_CERT=true

# Tabla que escribe el adquisidor en modo "actual".
DB_ESQUEMA=test
DB_TABLA=ValorActual

# ---- Aplicacion ----------------------------------------------
# Puerto publicado en el host. Adentro del contenedor es fijo (3108).
APP_PUERTO=3108

# Datos de ejemplo sin tocar la base: si | falla | viejo. Vacio en produccion.
DATOS_DEMO=

TZ=America/Argentina/Buenos_Aires
